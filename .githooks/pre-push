#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# TODO/build-014: CI no longer runs on push, so this is the gate. It refuses a push of main unless
# the unit suite and the full e2e matrix both ran on the pushed commit (scripts/todo-progress-lib.mjs).
# `git push --no-verify` skips it. core.hooksPath replaces .git/hooks, so the git-lfs hook runs here.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
# stdin carries the refs once; both consumers need it.
refs="$(cat)"
printf '%s\n' "$refs" | git lfs pre-push "$@" || exit $?
printf '%s\n' "$refs" | node scripts/todo-progress.mjs stamp verify-push
