{
  "name": "warpcad2",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e:headless": "playwright test",
    "docs:screenshots": "playwright test --project=docs-laptop",
    "docs:screenshots:update": "playwright test --project=docs-laptop --update-snapshots",
    "fixtures:v1-bolt": "node scripts/generate-v1-bolt-fixture.cjs",
    "fixtures:v1-nut": "node scripts/generate-v1-nut-fixture.cjs",
    "fixtures:v1-screw": "node scripts/generate-v1-screw-fixture.cjs",
    "test": "npm run typecheck && npm run test:unit -- --run && npm run test:e2e:headless",
    "spdx": "node scripts/spdx.mjs",
    "licenses": "npx --yes license-checker@25.0.1 --production --excludePackages \"warpcad2@0.0.0\" --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;MIT-0;CC0-1.0;(MIT OR CC0-1.0);MPL-2.0;CC-BY-4.0\" --summary"
  },
  "dependencies": {
    "@jscad/modeling": "2.13.0",
    "@jscad/obj-serializer": "2.1.23",
    "@jscad/stl-serializer": "2.1.23",
    "idb": "8.0.3",
    "pinia": "^4.0.3",
    "three": "0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/vue3-vite": "^10.6.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jscad-hardware": "1.1.0",
    "jscad-utils": "3.2.0",
    "jsdom": "^30.1.1",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  }
