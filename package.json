{
  "name": "warpcad",
  "version": "1.1.0",
  "private": true,
  "description": "Parametric CAD in the browser: drag-to-place solids, booleans, sketches, and an AI partner via MCP.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/WarpCad/warpcad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WarpCad/warpcad.git"
  },
  "bugs": {
    "url": "https://github.com/WarpCad/warpcad/issues"
  },
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release": "release-it",
    "typecheck": "vue-tsc --noEmit && tsc -p mcp/tsconfig.json",
    "test:unit": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e:headless": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke-chromium-laptop --project=smoke-webkit-tablet",
    "docs:screenshots": "playwright test --project=docs-laptop --project=docs-tablet --project=docs-phone --grep-invert @movie",
    "docs:screenshots:update": "playwright test --project=docs-laptop --project=docs-tablet --project=docs-phone --grep-invert @movie --update-snapshots",
    "docs:movies": "playwright test --project=docs-laptop --project=docs-tablet --project=docs-phone --grep @movie",
    "docs:gifs": "node scripts/docs-gifs.mjs",
    "docs:montage": "node scripts/docs-montage.mjs",
    "icons": "node scripts/app-icons.mjs",
    "docs:media": "npm run docs:screenshots && npm run docs:movies && npm run docs:gifs",
    "fixtures:v1-bolt": "node scripts/generate-v1-bolt-fixture.cjs",
    "fixtures:v1-nut": "node scripts/generate-v1-nut-fixture.cjs",
    "fixtures:v1-screw": "node scripts/generate-v1-screw-fixture.cjs",
    "test": "npm run typecheck && npm run test:unit -- --run && npm run test:e2e:headless",
    "spdx": "node scripts/spdx.mjs",
    "ai:stamp": "node scripts/stamp-ai-fixtures.mjs",
    "eval:ai": "node bench/ai/run.js",
    "mcp": "node mcp/server.js",
    "mcp:add": "node scripts/mcp-add.mjs",
    "mcp:install": "npm --prefix mcp ci",
    "mcp:licenses": "npm --prefix mcp run licenses",
    "licenses": "npx --yes license-checker@25.0.1 --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;MIT-0;CC0-1.0;(MIT OR CC0-1.0);MPL-2.0;CC-BY-4.0\" --summary"
  },
  "dependencies": {
    "@jscad/modeling": "2.13.0",
    "@jscad/obj-serializer": "2.1.23",
    "@jscad/stl-serializer": "2.1.23",
    "@sentry/vue": "11.8.0",
    "idb": "8.0.3",
    "pinia": "^4.0.3",
    "three": "0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@storybook/vue3-vite": "^10.6.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@zenai/playwright-coding-agent-reporter": "1.2.1",
    "jscad-hardware": "1.1.0",
    "jscad-utils": "3.2.0",
    "jsdom": "^30.1.1",
    "release-it": "21.1.1",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11",
    "yaml": "2.9.1"
  }
}
