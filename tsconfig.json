{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "typeRoots": ["./node_modules/@types", "./mcp/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.vue", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "e2e"]
}
